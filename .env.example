# ---- Public site identity ----
NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_CONTACT_EMAIL=hello@your-domain.example
NEXT_PUBLIC_CONTACT_PHONE=+94 77 000 0000

# ---- Persistence ----
# filesystem is for local development only; production requires durable.
PERSISTENCE_MODE=filesystem

# ---- Admin (Studio CRM at /admin) ----
# Use a long random value in production; the development fallback is rejected there.
ADMIN_TOKEN=change-me

# ---- Client portal (/portal) ----
# Secret for signing portal session cookies. Default in dev: flagship-portal-dev-secret
PORTAL_SECRET=change-me-too
# Set to "off" to hide dev magic links (when real email sending is wired)
# PORTAL_DEV_LINKS=off

# ---- Email (nodemailer: magic links + optional lead notifications) ----
# When set, portal login links are emailed; otherwise dev mode shows them inline.
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_SECURE=false          # true for port 465
# SMTP_USER=...
# SMTP_PASS=...
# SMTP_FROM="The Flagship <no-reply@theflagship.example>"
# Optional: notify this address when a new lead arrives
# MAILER_NOTIFY_EMAIL=studio@theflagship.example

# ---- Studio OS (/admin) ----
# Internal hourly delivery cost used by the finance view. Default: 40
# STUDIO_HOURLY_COST=40

# ---- AI Concierge + Brains (optional — falls back to built-in engines) ----
# Any ONE of these enables the LLM path:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# Or any OpenAI-compatible endpoint:
# CONCIERGE_API_URL=https://your-endpoint/v1/chat/completions
# CONCIERGE_API_KEY=...
# CONCIERGE_MODEL=gpt-4o-mini
